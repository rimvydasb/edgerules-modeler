{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EdgeRules model descriptions",
  "description": "docs/descriptions.json: the short description of each model path.",
  "type": "object",
  "required": ["schemaVersion", "byPath"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "byPath": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
